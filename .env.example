# Django Configuration
DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Supabase PostgreSQL is required for all application environments.
# Set DATABASE_URL to the connection URL from Project Settings > Database.
# Use the direct connection (IPv6-capable hosts) or Session Pooler.
# Require TLS and URL-encode special characters in the database password.
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/postgres?sslmode=require
USE_POSTGRES=1
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Redis and Celery
# Local single-process development uses an in-memory WebSocket layer by default.
# Set CHANNEL_REDIS_URL to a Redis 5+ service for multi-process WebSockets.
# Redis remains required for background jobs.
REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_REDIS_URL=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
