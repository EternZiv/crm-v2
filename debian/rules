#!/usr/bin/make -f

# Debian package build rules for Finlo CRM
# See debhelper(7) for details

# Enable all hardening features
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Python interpreter to use
PYTHON3 = python3

# Application directories
APP_DIR = /opt/finlo-crm
VENV_DIR = $(APP_DIR)/venv
CONFIG_DIR = /etc/finlo-crm
VAR_DIR = /var/lib/finlo-crm
LOG_DIR = /var/log/finlo-crm

%:
	dh $@ --with python3,systemd --buildsystem=pybuild

override_dh_auto_clean:
	rm -rf build/
	find . -name "*.pyc" -delete
	find . -name "__pycache__" -type d -exec rm -rf {} + || true

override_dh_auto_build:
	# Create virtual environment
	$(PYTHON3) -m venv $(CURDIR)/debian/tmp-venv

	# Install dependencies in virtual environment
	$(CURDIR)/debian/tmp-venv/bin/pip install --upgrade pip setuptools wheel
	$(CURDIR)/debian/tmp-venv/bin/pip install -r requirements.txt
	$(CURDIR)/debian/tmp-venv/bin/pip install gunicorn==22.0.0 whitenoise==6.7.0 psycopg2-binary==2.9.9

	# Collect static files (using temporary settings for build)
	DJANGO_SETTINGS_MODULE=finlo.settings.security_test \
	SECRET_KEY=build-time-secret \
	$(CURDIR)/debian/tmp-venv/bin/python manage.py collectstatic --noinput --clear

override_dh_auto_install:
	# Create directory structure
	mkdir -p $(CURDIR)/debian/finlo-crm$(APP_DIR)
	mkdir -p $(CURDIR)/debian/finlo-crm$(CONFIG_DIR)
	mkdir -p $(CURDIR)/debian/finlo-crm$(VAR_DIR)
	mkdir -p $(CURDIR)/debian/finlo-crm$(LOG_DIR)
	mkdir -p $(CURDIR)/debian/finlo-crm/usr/lib/systemd/system
	mkdir -p $(CURDIR)/debian/finlo-crm/usr/bin

	# Copy application files
	cp -r . $(CURDIR)/debian/finlo-crm$(APP_DIR)/

	# Remove unwanted files from app directory
	rm -rf $(CURDIR)/debian/finlo-crm$(APP_DIR)/debian
	rm -rf $(CURDIR)/debian/finlo-crm$(APP_DIR)/.git*
	rm -rf $(CURDIR)/debian/finlo-crm$(APP_DIR)/test*.json

	# Copy virtual environment
	cp -r $(CURDIR)/debian/tmp-venv/* $(CURDIR)/debian/finlo-crm$(VENV_DIR)/

	# Create configuration files
	echo "# Finlo CRM Configuration" > $(CURDIR)/debian/finlo-crm$(CONFIG_DIR)/finlo-crm.conf
	echo "DJANGO_SETTINGS_MODULE=finlo.settings" >> $(CURDIR)/debian/finlo-crm$(CONFIG_DIR)/finlo-crm.conf
	echo "SECRET_KEY=change-this-in-production" >> $(CURDIR)/debian/finlo-crm$(CONFIG_DIR)/finlo-crm.conf
	echo "DEBUG=0" >> $(CURDIR)/debian/finlo-crm$(CONFIG_DIR)/finlo-crm.conf
	echo "USE_POSTGRES=1" >> $(CURDIR)/debian/finlo-crm$(CONFIG_DIR)/finlo-crm.conf
	echo "ALLOWED_HOSTS=localhost,127.0.0.1" >> $(CURDIR)/debian/finlo-crm$(CONFIG_DIR)/finlo-crm.conf
	echo "CSRF_TRUSTED_ORIGINS=http://localhost:8000" >> $(CURDIR)/debian/finlo-crm$(CONFIG_DIR)/finlo-crm.conf

	# Create management wrapper script
	echo '#!/bin/bash' > $(CURDIR)/debian/finlo-crm/usr/bin/finlo-crm-manage
	echo 'cd /opt/finlo-crm' >> $(CURDIR)/debian/finlo-crm/usr/bin/finlo-crm-manage
	echo 'source /opt/finlo-crm/venv/bin/activate' >> $(CURDIR)/debian/finlo-crm/usr/bin/finlo-crm-manage
	echo 'export $$(cat /etc/finlo-crm/finlo-crm.conf | xargs)' >> $(CURDIR)/debian/finlo-crm/usr/bin/finlo-crm-manage
	echo 'exec python manage.py "$$@"' >> $(CURDIR)/debian/finlo-crm/usr/bin/finlo-crm-manage
	chmod +x $(CURDIR)/debian/finlo-crm/usr/bin/finlo-crm-manage

override_dh_auto_test:
	# Skip tests during package build
	# Tests can be run manually with: finlo-crm-manage test

override_dh_installinit:
	# Use systemd instead of init scripts
	dh_installinit --no-start

override_dh_systemd_enable:
	dh_systemd_enable --name=finlo-crm

override_dh_systemd_start:
	dh_systemd_start --no-start

.PHONY: build clean install
