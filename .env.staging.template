# =============================================================================
# Finlo CRM v2 — Staging Environment Configuration Template
# COPY TO '.env.staging' ON STAGING HOST. NEVER OVERWRITE LOCAL '.env'!
# =============================================================================

# Environment Identification
FINLO_TARGET_ENV=staging
DEBUG=0
SECRET_KEY=replace-with-a-unique-staging-secret-key-at-least-50-chars-long!
ALLOWED_HOSTS=staging-crm.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://staging-crm.example.com,http://localhost:8000

# -----------------------------------------------------------------------------
# Database Configuration (Dedicated Staging Supabase Project)
# DO NOT POINT TO MUMBAI (ordzcyrzqhdsavfkkouz) OR TOKYO BACKUPS!
# -----------------------------------------------------------------------------
# Set to the unique non-secret Project Reference of your staging Supabase instance
STAGING_PROJECT_REF=your-staging-project-ref

# Connect via Supabase Transaction Pooler (Port 6543) for 1,000 concurrency,
# or Session Pooler (Port 5432) for smaller baseline tests.
DATABASE_URL=postgresql://postgres.your-staging-project-ref:URL_ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Release connections immediately after request to maximize pooler client slots
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True

# Mandatory when using Supabase Transaction Pooler (Port 6543)
DISABLE_SERVER_SIDE_CURSORS=True

# -----------------------------------------------------------------------------
# Safe Outbound Integrations & Automation Suppressions
# Prevents sending real emails, SMS, calls, or third-party webhooks during load tests
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
DEFAULT_FROM_EMAIL=staging-no-reply@finlo.test

# Dummy Telephony (Twilio magic test credentials)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=00000000000000000000000000000000
TWILIO_PHONE_NUMBER=+15005550006

# External Webhooks & Sync suppression
DISABLE_EXTERNAL_WEBHOOKS=True

# -----------------------------------------------------------------------------
# Redis, Channels (WebSockets) & Celery
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Default password assigned to all synthetic staging users
FINLO_STAGING_USER_PASSWORD=FinloStagingPass123!

